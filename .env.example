BASE_URL=https://frontend
# Which deployment BASE_URL points at: DEV, UAT or CORE. Labels the Sector
# Analysis run folder (data/sector-analysis/<ENV>-<timestamp>/) and every
# report derived from it. Keep it in step with BASE_URL by hand - nothing
# cross-checks the two.
ENV=DEV
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=lameh-intelligence-eval

LAMEH_ORCHESTRATOR_URL=https://orchestrator-36462279645.me-central2.run.app

# The org the LangSmith eval suites run the agent as (tests/langsmith).
# Nothing else reads it.
LAMEH_ORGANIZATION_ID_FOR_INTELLIGENCE_EVAL=00000000-0000-0000-0000-000000000000
LAMEH_API_KEY=
LAMEH_USER_ID=
LAMEH_CHART_DATA_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# Board-analysis ground truth for the research suite. Only read when freezing
# the snapshot or checking it for drift; grading uses the committed file.
LAMEH_BOARD_ANALYSIS_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
